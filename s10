#include <stdio.h>
#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
struct ListNode* insertionSortList(struct ListNode* head) {
    if (!head || !head->next) return head;

    // Step 1: Create a dummy node to anchor the sorted list
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = NULL;

    struct ListNode* curr = head;

    // Step 2: Traverse the unsorted original list
    while (curr != NULL) {
        // Save the next unsorted node before we break current's links
        struct ListNode* next_node = curr->next;

        // Start scanning the sorted list from the dummy node
        struct ListNode* prev = &dummy;
        while (prev->next != NULL && prev->next->val < curr->val) {
            prev = prev->next;
        }

        // Step 3: Insert 'curr' between 'prev' and 'prev->next'
        curr->next = prev->next;
        prev->next = curr;

        // Step 4: Advance to the next unsorted node
        curr = next_node;
    }

    return dummy.next;
}
