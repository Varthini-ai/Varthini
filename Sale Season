# Reading the number of test cases
t = int(input())

for _ in range(t):
    x = int(input())
    
    # Checking from largest to smallest allows us to simplify conditions
    if x > 5000:
        print(x - 500)
    elif x > 1000:
        print(x - 100)
    elif x > 100:
        print(x - 25)
    else:
        # This covers the X <= 100 case
        print(x)
