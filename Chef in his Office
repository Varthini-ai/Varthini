# Read the number of test cases
t = int(input())

for _ in range(t):
    # Read X and Y from a single line
    x, y = map(int, input().split())
    
    # Calculate the total hours: 4 days at X hours + 1 day at Y hours
    total_hours = (4 * x) + y
    
    # Output the result
    print(total_hours)
