#include <stdio.h>

void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    int i = m - 1;         // Pointer for the last valid element in nums1
    int j = n - 1;         // Pointer for the last element in nums2
    int k = m + n - 1;     // Pointer for the last slot of the entire nums1 buffer
    
    // Merge both arrays starting from the end
    while (i >= 0 && j >= 0) {
        if (nums1[i] > nums2[j]) {
            nums1[k] = nums1[i];
            i--;
        } else {
            nums1[k] = nums2[j];
            j--;
        }
        k--;
    }
    
    // If elements remain in nums2, copy them over.
    // (If elements remain in nums1, they are already in their correct places!)
    while (j >= 0) {
        nums1[k] = nums2[j];
        j--;
        k--;
    }
}
