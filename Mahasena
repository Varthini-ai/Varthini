# cook your dish here
# Read the number of soldiers
n = int(input())
# Read the list of weapons per soldier
a = list(map(int, input().split()))

# Count the number of even integers (lucky soldiers)
even_count = 0
for x in a:
    if x % 2 == 0:
        even_count += 1

# Calculate the number of odd integers
odd_count = n - even_count

# Compare counts based on the problem condition
if even_count > odd_count:
    print("READY FOR BATTLE")
else:
    print("NOT READY")
