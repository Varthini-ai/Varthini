#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    long long va = *(int*)a;
    long long vb = *(int*)b;
    if (va < vb) return -1;
    if (va > vb) return 1;
    return 0;
}

int** fourSum(int* nums, int numsSize, int target, int* returnSize, int** returnColumnSizes) {
    // 1. Sort the input array
    qsort(nums, numsSize, sizeof(int), compare);
    
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    *returnSize = 0;
    
    // Guard clause: 4Sum requires at least 4 elements
    if (numsSize < 4) return result;
    
    // First loop: Anchor point 1
    for (int i = 0; i < numsSize - 3; i++) {
        if (i > 0 && nums[i] == nums[i - 1]) continue; // Skip duplicates for i
        
        // Optimization: Smallest possible sum in this loop exceeds target
        if ((long long)nums[i] + nums[i + 1] + nums[i + 2] + nums[i + 3] > target) break;
        // Optimization: Largest possible sum in this loop cannot reach target
        if ((long long)nums[i] + nums[numsSize - 1] + nums[numsSize - 2] + nums[numsSize - 3] < target) continue;
        
        // Second loop: Anchor point 2
        for (int j = i + 1; j < numsSize - 2; j++) {
            if (j > i + 1 && nums[j] == nums[j - 1]) continue; // Skip duplicates for j
            
            // Optimization: Smallest possible sum in this inner loop exceeds target
            if ((long long)nums[i] + nums[j] + nums[j + 1] + nums[j + 2] > target) break;
            // Optimization: Largest possible sum in this inner loop cannot reach target
            if ((long long)nums[i] + nums[j] + nums[numsSize - 1] + nums[numsSize - 2] < target) continue;
            
            int left = j + 1;
            int right = numsSize - 1;
            
            // Two-pointer scan
            while (left < right) {
                long long sum = (long long)nums[i] + nums[j] + nums[left] + nums[right];
                
                if (sum == target) {
                    // Resize output buffer if it runs out of capacity
                    if (*returnSize >= capacity) {
                        capacity *= 2;
                        result = (int**)realloc(result, capacity * sizeof(int*));
                        *returnColumnSizes = (int*)realloc(*returnColumnSizes, capacity * sizeof(int));
                    }
                    
                    // Allocate and save the matching quadruplet
                    result[*returnSize] = (int*)malloc(4 * sizeof(int));
                    result[*returnSize][0] = nums[i];
                    result[*returnSize][1] = nums[j];
                    result[*returnSize][2] = nums[left];
                    result[*returnSize][3] = nums[right];
                    (*returnColumnSizes)[*returnSize] = 4;
                    (*returnSize)++;
                    
                    // Skip duplicates for the two pointers
                    while (left < right && nums[left] == nums[left + 1]) left++;
                    while (left < right && nums[right] == nums[right - 1]) right--;
                    
                    left++;
                    right--;
                } else if (sum < target) {
                    left++;
                } else {
                    right--;
                }
            }
        }
    }
    
    return result;
}
