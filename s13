#include <stdio.h>

int majorityElement(int* nums, int numsSize) {
    int candidate = 0;
    int count = 0;
    
    for (int i = 0; i < numsSize; i++) {
        // If count hits 0, choose the current element as the new candidate
        if (count == 0) {
            candidate = nums[i];
        }
        
        // If current element matches the candidate, increment count.
        // Otherwise, decrement count (cancelling out different elements).
        if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }
    
    return candidate;
}
