#include <stdio.h>
#include <stdlib.h>

// Comparison function for sorting intervals by their start times
int compare(const void* a, const void* b) {
    int* intervalA = *(int**)a;
    int* intervalB = *(int**)b;
    
    // Sort primarily by start value
    if (intervalA[0] != intervalB[0]) {
        return intervalA[0] - intervalB[0];
    }
    // If start values are equal, sort by end value
    return intervalA[1] - intervalB[1];
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned arrays and *returnColumnSizes array must be malloced.
 */
int** merge(int** intervals, int intervalsSize, int* intervalsColSize, int* returnSize, int** returnColumnSizes) {
    if (intervalsSize <= 1) {
        *returnSize = intervalsSize;
        *returnColumnSizes = (int*)malloc(intervalsSize * sizeof(int));
        for (int i = 0; i < intervalsSize; i++) {
            (*returnColumnSizes)[i] = 2;
        }
        return intervals; // Nothing or only one thing to merge
    }

    // Step 1: Sort the intervals by their start points
    qsort(intervals, intervalsSize, sizeof(int*), compare);

    // Allocate memory for the merged results
    int** result = (int**)malloc(intervalsSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(intervalsSize * sizeof(int));
    
    int count = 0;
    
    // Insert the first interval to kickstart the merging process
    result[count] = (int*)malloc(2 * sizeof(int));
    result[count][0] = intervals[0][0];
    result[count][1] = intervals[0][1];
    (*returnColumnSizes)[count] = 2;
    count++;

    // Step 2: Iterate and merge overlapping intervals
    for (int i = 1; i < intervalsSize; i++) {
        // Grab the last interval we inserted into the result list
        int last_start = result[count - 1][0];
        int last_end = result[count - 1][1];
        
        int curr_start = intervals[i][0];
        int curr_end = intervals[i][1];

        if (curr_start <= last_end) {
            // Overlap detected! Merge by extending the end boundary if needed
            if (curr_end > last_end) {
                result[count - 1][1] = curr_end;
            }
        } else {
            // No overlap! Add a fresh interval to the results list
            result[count] = (int*)malloc(2 * sizeof(int));
            result[count][0] = curr_start;
            result[count][1] = curr_end;
            (*returnColumnSizes)[count] = 2;
            count++;
        }
    }

    *returnSize = count;
    return result;
}
