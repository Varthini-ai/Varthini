#include <stdio.h>
#include <stdlib.h>

int largestRectangleArea(int* heights, int heightsSize) {
    // Allocate memory for the index stack
    // We add 1 to the capacity to handle a trailing sentinel zero safely
    int* stack = (int*)malloc((heightsSize + 1) * sizeof(int));
    int top = -1;
    int max_area = 0;
    
    // Loop runs one extra time (up to heightsSize) to act as a sentinel value (height 0)
    for (int i = 0; i <= heightsSize; i++) {
        // Use 0 as the height for the sentinel element past the end of the array
        int current_height = (i == heightsSize) ? 0 : heights[i];
        
        // Maintain a monotonic increasing stack
        while (top != -1 && heights[stack[top]] >= current_height) {
            int height = heights[stack[top--]]; // Pop the height of the rectangle
            
            // If the stack is empty, the rectangle extends all the way to the index 0
            // Otherwise, its left boundary is limited by the new top of the stack
            int width = (top == -1) ? i : (i - stack[top] - 1);
            
            int area = height * width;
            if (area > max_area) {
                max_area = area;
            }
        }
        
        // Push the current index onto the stack
        stack[++top] = i;
    }
    
    // Free allocated memory
    free(stack);
    
    return max_area;
}
